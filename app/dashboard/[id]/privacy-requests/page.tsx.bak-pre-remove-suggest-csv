                <div className="overflow-x-auto">
                  <table className="w-full text-sm">
                    <thead className="bg-[#F9FAFB] text-left text-[#6B7280]">
                      <tr>
                        <th className="px-5 py-2.5 font-medium">Reference</th>
                        <th className="px-5 py-2.5 font-medium">Request</th>
                        <th className="px-5 py-2.5 font-medium">Law</th>
                        <th className="px-5 py-2.5 font-medium">Received</th>
                        <th className="px-5 py-2.5 font-medium">Deadline</th>
                        <th className="px-5 py-2.5 font-medium">Status</th>
                      </tr>
                    </thead>
                    {requests.map((r) => (
                      <tbody key={r.id} className="border-t border-[#E5E7EB]">
                        <tr
                          className="cursor-pointer hover:bg-[#F9FAFB]"
                          onClick={() => setOpenId(openId === r.id ? null : r.id)}
                          aria-expanded={openId === r.id}
                        >
                          <td className="px-5 py-3 font-medium text-[#111827] whitespace-nowrap">{r.ref}</td>
                          <td className="px-5 py-3">{TYPE_LABEL[r.type] || r.type}</td>
                          <td className="px-5 py-3 whitespace-nowrap">{r.law}</td>
                          <td className="px-5 py-3 whitespace-nowrap">{fmtDate(r.createdAt)}</td>
                          <td className="px-5 py-3 whitespace-nowrap"><DueCell req={r} /></td>
                          <td className="px-5 py-3">
                            <span className={`inline-block px-2.5 py-1 rounded-full text-xs font-medium ${STATUS_STYLE[r.status]}`}>
                              {STATUS_LABEL[r.status] || r.status}
                            </span>
                          </td>
                        </tr>
                        {openId === r.id && (
                          <tr>
                            <td colSpan={6} className="p-0">
                              <RequestDetail siteId={siteId} req={r} canEdit={!!data.canEdit} onChanged={load} />
                            </td>
                          </tr>
                        )}
                      </tbody>
                    ))}
                  </table>
                </div>
              )}
            </div>
          </>
        )}
      </div>
    </div>
  );
}
