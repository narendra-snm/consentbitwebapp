'use client';

// Privacy Requests tab: requests visitors sent through the public form
// (/privacy-request/<domain> on the consentbit-privacy-requests worker), with the legal
// deadline for each. Owner and team Admins can act; Members see them read-only.

import Link from 'next/link';
import { useCallback, useEffect, useState, type ReactNode } from 'react';
import { useParams } from 'next/navigation';
import { suggestReply, type SuggestAction } from '@/lib/privacyReplySuggest';

type PrivacyRequest = {
  id: string;
  ref: string;
  type: 'access' | 'delete' | 'correct' | 'optout';
  region: string;
  law: string;
  name: string | null;
  email: string;
  message: string | null;
  consentId: string | null;
  status: 'new' | 'in_progress' | 'completed' | 'rejected';
  createdAt: string;
  verifiedAt: string | null;
  dueAt: string;
  extendedAt: string | null;
  completedAt: string | null;
  reply: string | null;
  ownerNote: string | null;
};

type ListResponse = {
  success: boolean;
  error?: string;
  enabled?: boolean;
  canEdit?: boolean;
  publicUrl?: string | null;
  requests?: PrivacyRequest[];
};

type RequestEvent = { at: string; action: string; detail: string | null };

// The visitor's cookie consent records, matched by their Consent ID (read-only on the worker).
type ConsentRecord = {
  id: string;
  consentId: string | null;
  createdAt: string;
  expiresAt: string | null;
  status: string | null;
  consentMethod: string | null;
  regulation: string | null;
  bannerType: string | null;
  country: string | null;
  region: string | null;
  ipAddress: string | null;
  userAgent: string | null;
  domain: string | null;
  categories: Record<string, boolean> | null;
  doNotSell: boolean | null;
};

const CATEGORY_LABEL: Record<string, string> = {
  essential: 'Necessary',
  necessary: 'Necessary',
  analytics: 'Analytics',
  preferences: 'Preferences',
  functional: 'Functional',
  marketing: 'Marketing',
};

function choiceOf(c: ConsentRecord): { text: string; tone: string } {
  if (c.doNotSell !== null) {
    return c.doNotSell
      ? { text: 'Opted out of sale/sharing', tone: 'bg-[#F3F4F6] text-[#374151]' }
      : { text: 'Allowed sale/sharing', tone: 'bg-[#ECFDF5] text-[#047857]' };
  }
  const optional = Object.entries(c.categories || {}).filter(([k]) => k !== 'essential' && k !== 'necessary');
  if (optional.length) {
    const on = optional.filter(([, v]) => v).length;
    if (on === optional.length) return { text: 'Accepted all', tone: 'bg-[#ECFDF5] text-[#047857]' };
    if (on === 0) return { text: 'Rejected all', tone: 'bg-[#F3F4F6] text-[#374151]' };
    return { text: 'Accepted some', tone: 'bg-[#FEF3C7] text-[#92400E]' };
  }
  if (c.status === 'given') return { text: 'Accepted', tone: 'bg-[#ECFDF5] text-[#047857]' };
  if (c.status === 'rejected') return { text: 'Rejected', tone: 'bg-[#F3F4F6] text-[#374151]' };
  return { text: c.status || 'Recorded', tone: 'bg-[#F3F4F6] text-[#374151]' };
}

const fmtDateTime = (iso: string | null) =>
  iso
    ? new Date(iso).toLocaleString(undefined, { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })
    : '—';

function downloadConsentCsv(ref: string, records: ConsentRecord[]) {
  const head = ['Date (UTC)', 'Consent ID', 'Record ID', 'Choice', 'Categories', 'Do not sell', 'Law', 'Banner', 'Method',
    'Country', 'Region', 'IP (shortened)', 'Browser', 'Valid until (UTC)'];
  const cell = (v: unknown) => `"${String(v ?? '').replace(/"/g, '""')}"`;
  const rows = records.map((c) => [
    c.createdAt, c.consentId, c.id, choiceOf(c).text,
    Object.entries(c.categories || {}).map(([k, v]) => `${CATEGORY_LABEL[k] || k}: ${v ? 'yes' : 'no'}`).join('; '),
    c.doNotSell === null ? '' : c.doNotSell ? 'yes' : 'no',
    (c.regulation || '').toUpperCase(), c.bannerType, c.consentMethod, c.country, c.region, c.ipAddress, c.userAgent, c.expiresAt,
  ].map(cell).join(','));
  const blob = new Blob([[head.map(cell).join(','), ...rows].join('\r\n')], { type: 'text/csv;charset=utf-8' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `${ref}-consent-records.csv`;
  a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
}

function ConsentRecords({ siteId, req, records }: { siteId: string; req: PrivacyRequest; records: ConsentRecord[] | null | undefined }) {
  const [copied, setCopied] = useState(false);
  const logsLink = (
    <Link href={`/dashboard/${siteId}/consent-logs`} className="text-[#007AFF] underline">Consent Logs</Link>
  );
  const copyId = async () => {
    try {
      await navigator.clipboard.writeText(req.consentId || '');
      setCopied(true);
      setTimeout(() => setCopied(false), 1500);
    } catch {
      /* clipboard blocked; the ID is shown above */
    }
  };

  let body: ReactNode;
  if (!req.consentId) {
    body = (
      <p className="text-[#4B5563]">
        The visitor didn&apos;t add a Consent ID, so their cookie consent records can&apos;t be matched. You can ask them for it in
        your reply (it is in the <code className="text-xs">consentbit-consentid</code> cookie on your website).
      </p>
    );
  } else if (records === undefined) {
    body = <p className="text-[#6B7280]">Loading records…</p>;
  } else if (!records || records.length === 0) {
    body = (
      <p className="text-[#4B5563]">
        No records found for this Consent ID. They may already be deleted, past their retention period, or the ID was copied
        wrongly.
      </p>
    );
  } else {
    body = (
      <>
        <ul className="space-y-2">
          {records.map((c) => {
            const choice = choiceOf(c);
            return (
              <li key={c.id} className="bg-white border border-[#E5E7EB] rounded-lg p-3">
                <div className="flex flex-wrap items-center justify-between gap-2">
                  <span className="font-medium text-[#111827]">{fmtDateTime(c.createdAt)}</span>
                  <span className={`inline-block px-2.5 py-0.5 rounded-full text-xs font-medium ${choice.tone}`}>{choice.text}</span>
                </div>
                {c.categories && (
                  <div className="flex flex-wrap gap-1.5 mt-2">
                    {Object.entries(c.categories).map(([k, v]) => (
                      <span
                        key={k}
                        className={`px-2 py-0.5 rounded text-xs border ${v ? 'border-[#A7F3D0] bg-[#ECFDF5] text-[#047857]' : 'border-[#E5E7EB] bg-[#F9FAFB] text-[#6B7280] line-through'}`}
                      >
                        {CATEGORY_LABEL[k] || k}
                      </span>
                    ))}
                  </div>
                )}
                <p className="text-xs text-[#6B7280] mt-2">
                  {[
                    c.regulation && c.regulation.toUpperCase(),
                    c.consentMethod && `via ${c.consentMethod}`,
                    [c.region, c.country].filter(Boolean).join(', '),
                    c.ipAddress && `IP ${c.ipAddress}`,
                    c.expiresAt && `valid until ${fmtDate(c.expiresAt)}`,
                  ].filter(Boolean).join(' · ')}
                </p>
              </li>
            );
          })}
        </ul>
        <div className="flex flex-wrap items-center gap-2 mt-3">
          <button
            className="h-9 px-4 rounded-lg text-sm font-medium bg-white border border-[#E5E5E5] text-[#111827]"
            onClick={() => downloadConsentCsv(req.ref, records)}
          >
            Download CSV
          </button>
          {req.type === 'delete' && (
            <button className="h-9 px-4 rounded-lg text-sm font-medium bg-white border border-[#E5E5E5] text-[#111827]" onClick={copyId}>
              {copied ? 'Copied' : 'Copy Consent ID'}
            </button>
          )}
        </div>
        <p className="text-xs text-[#6B7280] mt-2">
          {req.type === 'access' && <>Attach the CSV to your reply, or paste the details into the message. </>}
          {req.type === 'delete' && <>To delete them, open {logsLink}, paste the Consent ID into Find visitor and delete. </>}
          IP addresses are shortened.
        </p>
      </>
    );
  }

  return (
    <div>
      <p className="text-[#6B7280] mb-1">
        Cookie consent records{records && records.length ? ` (${records.length})` : ''}
      </p>
      <div className="text-sm">{body}</div>
      <p className="text-xs text-[#6B7280] mt-2">
        ConsentBit only holds cookie consent records. Any other data you hold about them (forms, orders, emails, CRM) you need to
        handle yourself.
      </p>
    </div>
  );
}

const TYPE_LABEL: Record<PrivacyRequest['type'], string> = {
  access: 'See a copy of their data',
  delete: 'Delete their data',
  correct: 'Correct their data',
  optout: 'Stop selling or sharing',
};

const STATUS_LABEL: Record<PrivacyRequest['status'], string> = {
  new: 'New',
  in_progress: 'In progress',
  completed: 'Completed',
  rejected: 'Rejected',
};

const STATUS_STYLE: Record<PrivacyRequest['status'], string> = {
  new: 'bg-[#EFF6FF] text-[#1D4ED8]',
  in_progress: 'bg-[#FEF3C7] text-[#92400E]',
  completed: 'bg-[#ECFDF5] text-[#047857]',
  rejected: 'bg-[#F3F4F6] text-[#4B5563]',
};

const EVENT_LABEL: Record<string, string> = {
  submitted: 'Request sent',
  verified: 'Visitor confirmed their email',
  started: 'Marked in progress',
  extended: 'Deadline extended',
  completed: 'Completed, visitor emailed',
  rejected: 'Rejected, visitor emailed',
  note: 'Internal note saved',
  reminder: 'Deadline reminder sent',
  overdue_alert: 'Overdue alert sent',
};

const fmtDate = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' }) : '—';

function daysLeft(dueAt: string) {
  return Math.ceil((Date.parse(dueAt) - Date.now()) / 86400000);
}

function DueCell({ req }: { req: PrivacyRequest }) {
  if (req.status === 'completed' || req.status === 'rejected') {
    return <span className="text-[#6B7280]">Closed {fmtDate(req.completedAt)}</span>;
  }
  const d = daysLeft(req.dueAt);
  const tone = d < 0 ? 'text-[#B91C1C] font-semibold' : d <= 7 ? 'text-[#B45309] font-semibold' : 'text-[#111827]';
  const text = d < 0 ? `${-d} day${d === -1 ? '' : 's'} overdue` : d === 0 ? 'Due today' : `${d} day${d === 1 ? '' : 's'} left`;
  return (
    <span className={tone}>
      {text}
      <span className="block text-xs font-normal text-[#6B7280]">
        {fmtDate(req.dueAt)}
        {req.extendedAt ? ' (extended)' : ''}
      </span>
    </span>
  );
}

async function postUpdate(body: Record<string, string>) {
  const res = await fetch('/api/privacy-requests/update', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  const data = (await res.json().catch(() => ({ success: false, error: 'Something went wrong.' }))) as {
    success?: boolean;
    error?: string;
  };
  if (!res.ok || !data.success) throw new Error(data.error || 'Something went wrong.');
  return data;
}

function RequestDetail({
  siteId,
  req,
  canEdit,
  onChanged,
}: {
  siteId: string;
  req: PrivacyRequest;
  canEdit: boolean;
  onChanged: () => void;
}) {
  const [reply, setReply] = useState('');
  const [note, setNote] = useState(req.ownerNote || '');
  const [events, setEvents] = useState<RequestEvent[]>([]);
  const [consents, setConsents] = useState<ConsentRecord[] | null | undefined>(undefined);
  const [busy, setBusy] = useState<string | null>(null);
  const [error, setError] = useState<string | null>(null);
  const open = req.status === 'new' || req.status === 'in_progress';

  useEffect(() => {
    const params = new URLSearchParams({ siteId, id: req.id });
    fetch(`/api/privacy-requests/events?${params.toString()}`)
      .then((r) => r.json() as Promise<{ events?: RequestEvent[]; consents?: ConsentRecord[] | null }>)
      .then((d) => {
        setEvents(d?.events || []);
        setConsents(d?.consents ?? null);
      })
      .catch(() => {
        setEvents([]);
        setConsents(null);
      });
  }, [siteId, req.id, req.status, req.dueAt, req.ownerNote]);

  const act = async (action: string, extra: Record<string, string> = {}) => {
    setBusy(action);
    setError(null);
    try {
      await postUpdate({ siteId, id: req.id, action, ...extra });
      if (action !== 'note') setReply('');
      onChanged();
    } catch (e: any) {
      setError(e?.message || 'Something went wrong.');
    } finally {
      setBusy(null);
    }
  };

  const btn = 'h-9 px-4 rounded-lg text-sm font-medium disabled:opacity-50 disabled:cursor-not-allowed';

  // Fill the message box with a draft for the chosen outcome. The owner edits the
  // [bracketed] parts before sending. Asks first if they already typed something.
  const suggest = (action: SuggestAction) => {
    if (reply.trim() && !window.confirm('Replace what you wrote with a suggested reply?')) return;
    setReply(suggestReply(req, consents, action).slice(0, 4000));
  };
  const suggestLink = 'text-[#007AFF] hover:underline disabled:text-[#9CA3AF] disabled:no-underline disabled:cursor-not-allowed';

  return (
    <div className="bg-[#F9FAFB] border-t border-[#E5E7EB] px-5 py-5 grid gap-6 md:grid-cols-2">
      <div className="space-y-3 text-sm">
        <dl className="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5">
          <dt className="text-[#6B7280]">Name</dt><dd>{req.name || '—'}</dd>
          <dt className="text-[#6B7280]">Email</dt><dd className="break-all">{req.email}</dd>
          <dt className="text-[#6B7280]">Law</dt><dd>{req.law}</dd>
          <dt className="text-[#6B7280]">Received</dt><dd>{fmtDate(req.createdAt)}</dd>
          <dt className="text-[#6B7280]">Consent ID</dt>
          <dd className="break-all">{req.consentId || '—'}</dd>
        </dl>
        {req.message && (
          <div>
            <p className="text-[#6B7280] mb-1">Their message</p>
            <p className="whitespace-pre-wrap bg-white border border-[#E5E7EB] rounded-lg p-3">{req.message}</p>
          </div>
        )}
        <ConsentRecords siteId={siteId} req={req} records={consents} />
        {req.reply && (
          <div>
            <p className="text-[#6B7280] mb-1">Your reply to the visitor</p>
            <p className="whitespace-pre-wrap bg-white border border-[#E5E7EB] rounded-lg p-3">{req.reply}</p>
          </div>
        )}
        <div>
          <p className="text-[#6B7280] mb-1">History</p>
          <ul className="space-y-1">
            {events.map((e, i) => (
              <li key={i} className="flex gap-3">
                <span className="text-[#6B7280] shrink-0 w-28">
                  {new Date(e.at).toLocaleString(undefined, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}
                </span>
                <span>
                  {EVENT_LABEL[e.action] || e.action}
                  {e.action === 'extended' && e.detail ? ` to ${fmtDate(e.detail)}` : ''}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div className="space-y-4 text-sm">
        {!canEdit && (
          <p className="text-[#6B7280]">Only the account owner or a team Admin can handle requests.</p>
        )}
        {canEdit && open && (
          <div className="space-y-2">
            <div className="flex flex-wrap items-baseline justify-between gap-2">
              <label className="block font-medium text-[#111827]" htmlFor={`reply-${req.id}`}>
                Message to the visitor
              </label>
              <span className="text-xs text-[#6B7280]">
                Suggest a reply for:{' '}
                <button type="button" className={suggestLink} disabled={consents === undefined} onClick={() => suggest('complete')}>
                  Complete
                </button>
                {' · '}
                <button type="button" className={suggestLink} onClick={() => suggest('reject')}>
                  Reject
                </button>
                {!req.extendedAt && (
                  <>
                    {' · '}
                    <button type="button" className={suggestLink} onClick={() => suggest('extend')}>
                      Extend
                    </button>
                  </>
                )}
              </span>
            </div>
            <textarea
              id={`reply-${req.id}`}
              value={reply}
              onChange={(e) => setReply(e.target.value.slice(0, 4000))}
              placeholder="For example: we have deleted your account and all records we hold about you. Required when rejecting or extending."
              className="w-full min-h-[110px] p-3 bg-white border border-[#E5E5E5] rounded-lg focus:outline-none focus:border-[#007AFF]"
            />
            <div className="flex flex-wrap gap-2">
              {req.status === 'new' && (
                <button className={`${btn} bg-white border border-[#E5E5E5] text-[#111827]`} disabled={!!busy} onClick={() => act('start')}>
                  {busy === 'start' ? 'Saving…' : 'Mark in progress'}
                </button>
              )}
              <button className={`${btn} bg-[#007AFF] text-white`} disabled={!!busy} onClick={() => act('complete', { reply })}>
                {busy === 'complete' ? 'Sending…' : 'Complete & email visitor'}
              </button>
              <button
                className={`${btn} bg-white border border-[#E5E5E5] text-[#B91C1C]`}
                disabled={!!busy || !reply.trim()}
                title={reply.trim() ? '' : 'Write the reason in the message first'}
                onClick={() => act('reject', { reply })}
              >
                {busy === 'reject' ? 'Sending…' : 'Reject'}
              </button>
              {!req.extendedAt && (
                <button
                  className={`${btn} bg-white border border-[#E5E5E5] text-[#111827]`}
                  disabled={!!busy || !reply.trim()}
                  title={reply.trim() ? '' : 'Write the reason in the message first'}
                  onClick={() => act('extend', { reply })}
                >
                  {busy === 'extend' ? 'Saving…' : 'Extend deadline'}
                </button>
              )}
            </div>
            <p className="text-xs text-[#6B7280]">
              The visitor is emailed when you complete, reject or extend. Extending is allowed once, and only where the law allows it
              (GDPR +2 months, US state laws +45 days, PIPEDA +30 days).
            </p>
          </div>
        )}
        {canEdit && (
          <div className="space-y-2">
            <label className="block font-medium text-[#111827]" htmlFor={`note-${req.id}`}>
              Internal note <span className="font-normal text-[#6B7280]">(not sent to the visitor)</span>
            </label>
            <textarea
              id={`note-${req.id}`}
              value={note}
              onChange={(e) => setNote(e.target.value.slice(0, 4000))}
              className="w-full min-h-[70px] p-3 bg-white border border-[#E5E5E5] rounded-lg focus:outline-none focus:border-[#007AFF]"
            />
            <button
              className={`${btn} bg-white border border-[#E5E5E5] text-[#111827]`}
              disabled={!!busy || note === (req.ownerNote || '')}
              onClick={() => act('note', { note })}
            >
              {busy === 'note' ? 'Saving…' : 'Save note'}
            </button>
          </div>
        )}
        {error && <p className="text-sm text-[#B91C1C]">{error}</p>}
      </div>
    </div>
  );
}

export default function PrivacyRequestsPage() {
  const params = useParams<{ id: string }>();
  const siteId = String(params?.id || '');
  const [data, setData] = useState<ListResponse | null>(null);
  const [loading, setLoading] = useState(true);
  const [openId, setOpenId] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);

  const load = useCallback(async () => {
    if (!siteId) return;
    try {
      const res = await fetch(`/api/privacy-requests?siteId=${encodeURIComponent(siteId)}`, { cache: 'no-store' });
      setData(await res.json());
    } catch {
      setData({ success: false, error: 'Could not load privacy requests.' });
    } finally {
      setLoading(false);
    }
  }, [siteId]);

  useEffect(() => {
    load();
  }, [load]);

  const copy = async () => {
    if (!data?.publicUrl) return;
    try {
      await navigator.clipboard.writeText(data.publicUrl);
      setCopied(true);
      setTimeout(() => setCopied(false), 1500);
    } catch {
      /* clipboard blocked; the link is visible to copy by hand */
    }
  };

  const requests = data?.requests || [];
  const openCount = requests.filter((r) => r.status === 'new' || r.status === 'in_progress').length;

  return (
    <div className="w-full bg-white px-4 md:px-8 pt-6 pb-12">
      <div className="max-w-[1259px] mx-auto space-y-6">
        <div>
          <h1 className="text-2xl font-semibold text-[#111827]">Privacy Requests</h1>
          <p className="text-[#4B5563] mt-1">
            Visitors use your request page to ask you to show, delete or correct their data, or to stop selling or sharing it.
            Each request has a legal deadline.
          </p>
        </div>

        {loading && <p className="text-[#6B7280]">Loading…</p>}

        {!loading && data && !data.success && <p className="text-[#B91C1C]">{data.error || 'Could not load privacy requests.'}</p>}

        {!loading && data?.success && !data.enabled && (
          <div className="border border-[#E5E7EB] rounded-xl p-6 bg-[#F9FAFB]">
            <h2 className="text-lg font-semibold text-[#111827]">Available on Essential and Growth</h2>
            <p className="text-[#4B5563] mt-1">
              Get a privacy request page for your visitors, deadline tracking and reminders. Every privacy law requires a way for
              visitors to make these requests.
            </p>
            <Link href={`/dashboard/${siteId}/upgrade`} className="inline-block mt-4 h-10 leading-10 px-5 rounded-lg bg-[#007AFF] text-white font-medium">
              Upgrade
