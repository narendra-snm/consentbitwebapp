  .bar { display: flex; justify-content: flex-end; gap: 8px; margin-bottom: 16px; }
  .bar button { height: 36px; padding: 0 14px; border-radius: 8px; border: 1px solid #007aff; background: #007aff; color: #fff; font: inherit; font-size: 14px; cursor: pointer; }
  h1 { font-size: 26px; line-height: 1.25; margin: 0 0 8px; }
  h2 { font-size: 18px; margin: 32px 0 8px; padding-top: 8px; }
  h3 { font-size: 16px; margin: 22px 0 6px; }
  p { margin: 0 0 12px; }
  ul, ol { margin: 0 0 12px; padding-left: 22px; }
  ol.alpha { list-style: none; padding-left: 22px; }
  li { margin-bottom: 4px; }
  hr { border: 0; border-top: 1px solid #e5e7eb; margin: 32px 0; }
